APP_ENV=local

DB_HOST=localhost
DB_NAME=caremeal
DB_PORT=3306
DB_CHARSET=utf8mb4
DB_USER=root
DB_PASS=

GEMINI_API_KEY=replace_with_your_new_key
GEMINI_API_KEYS=replace_key_1,replace_key_2,replace_key_3
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_MODELS=gemini-2.5-flash-lite,gemini-2.0-flash
ADMIN_AI_PRIMARY=groq

STUDENT_GEMINI_API_KEY=replace_with_student_key
STUDENT_GEMINI_API_KEYS=replace_student_key_1,replace_student_key_2
STUDENT_GEMINI_MODEL=gemini-2.5-flash-lite
STUDENT_GEMINI_MODELS=gemini-2.5-flash-lite,gemini-2.5-flash
STUDENT_AI_PRIMARY=groq

GROQ_API_KEY=replace_with_groq_key
GROQ_API_KEYS=replace_groq_key_1,replace_groq_key_2
GROQ_MODEL=llama-3.1-8b-instant
GROQ_MODELS=llama-3.1-8b-instant,llama-3.3-70b-versatile


GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_STT_LANGUAGE=fr
STUDENT_GROQ_API_KEY=replace_with_student_groq_key
STUDENT_GROQ_API_KEYS=replace_student_groq_key_1,replace_student_groq_key_2
STUDENT_GROQ_MODEL=llama-3.1-8b-instant
STUDENT_GROQ_MODELS=llama-3.1-8b-instant,llama-3.3-70b-versatile

# Dedicated CareMeal chatbot (independent from other assistants)
CHATBOT_AI_PRIMARY=gemini
CHATBOT_GEMINI_API_KEY=replace_with_chatbot_gemini_key
CHATBOT_GEMINI_API_KEYS=replace_chatbot_gemini_key_1,replace_chatbot_gemini_key_2
CHATBOT_GEMINI_MODEL=gemini-2.5-flash-lite
CHATBOT_GEMINI_MODELS=gemini-2.5-flash-lite,gemini-2.5-flash

# Matching AI — semantic enhancement for restaurant matching
CAREMEAL_GEMINI_ENABLED=1
CAREMEAL_GEMINI_API_KEY=replace_with_matching_gemini_key
CAREMEAL_GEMINI_MODEL=gemini-2.5-flash-lite
